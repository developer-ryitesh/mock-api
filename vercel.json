{
   "version": 2,
   "builds": [
      { "src": "build/index.js", "use": "@vercel/node" },
      { "src": "build/views/**", "use": "@vercel/static" }
   ],
   "routes": [
      { "src": "/api/(.*)", "dest": "build/index.js" },
      { "src": "/assets/(.*)", "dest": "/build/views/assets/$1" },
      { "src": "/(.*)", "dest": "/build/views/index.html" }
   ]
}
